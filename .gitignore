# =============================================================================
# .gitignore — Arsenal Lucrativo
# =============================================================================

# Variáveis de ambiente (NUNCA commitar)
.env
.env.local
.env.*.local

# Dependências
node_modules/
**/node_modules/

# Build outputs
**/dist/
**/build/
**/.next/

# Cobertura de testes
**/coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sistema Operacional
.DS_Store
Thumbs.db
desktop.ini

# IDEs e editores
.vscode/
.idea/
*.swp
*.swo
*.suo

# Docker
.docker/

# Temporários
*.tmp
*.temp
