# API Backend REST
VITE_API_URL=http://localhost:3000/api

# WebSocket / Socket.io Server (Telemetria em Tempo Real)
VITE_WS_URL=http://localhost:3000

# Alternância de Fonte de Dados (MOCK vs API REAL)
# true: utiliza fixtures estáticas resilientes de bdmock.ts
# false: consome os endpoints reais da API Backend e Supabase
VITE_USE_MOCK_DATA=true

# Supabase Client (Chaves Públicas de Acesso Anônimo)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
